#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_configure:
	:

override_dh_auto_build:
	:

override_dh_shlibdeps:
	:

override_dh_dwz:
	:

override_dh_auto_test:
	desktop-file-validate helium.desktop

override_dh_auto_install:
	mkdir -p debian/helium-browser/opt/helium debian/helium-browser/usr/bin debian/helium-browser/usr/share/applications debian/helium-browser/usr/share/metainfo debian/helium-browser/usr/share/icons/hicolor/256x256/apps; \
	find . -maxdepth 1 -mindepth 1 ! -name debian ! -name '.pc' -exec cp -a -t debian/helium-browser/opt/helium/ {} +
	sed -Ei "s/(CHROME_VERSION_EXTRA=).*/\1suse/" debian/helium-browser/opt/helium/helium-wrapper
	install -m 644 debian/helium-browser/opt/helium/product_logo_256.png \
	    debian/helium-browser/usr/share/icons/hicolor/256x256/apps/helium.png
	desktop-file-install --dir=debian/helium-browser/usr/share/applications \
	    debian/helium-browser/opt/helium/helium.desktop
	install -m 644 debian/net.imput.helium.metainfo.xml \
	    debian/helium-browser/usr/share/metainfo/net.imput.helium.metainfo.xml
	ln -sf /opt/helium/helium-wrapper debian/helium-browser/usr/bin/helium
