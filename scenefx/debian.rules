#!/usr/bin/make -f
# Debian build of upstream scenefx 0.5 (meson) against the wlroots
# package from this same repository.
%:
	dh $@

override_dh_auto_clean:
	mkdir -p debian/source; \
	printf '%s\n' 'extend-diff-ignore = "build/.*"' 'extend-diff-ignore = "obj-.*/.*"' > debian/source/options; \
	dh_auto_clean

override_dh_auto_configure:
	dh_auto_configure --buildsystem=meson -- --prefix=/usr --libdir=lib/x86_64-linux-gnu -Dexamples=false

override_dh_auto_build:
	dh_auto_build --buildsystem=meson

override_dh_auto_test:
	:

override_dh_auto_install:
	dh_auto_install --buildsystem=meson
