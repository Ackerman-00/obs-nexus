# Maintainer: Ackerman-00
# Arch recipe mirroring concat-unstable.spec (Rust main-branch snapshot). x86_64
# only: upstream ships prebuilt FFmpeg/ONNX/Skia/sherpa sidecars for x86_64.
pkgname=concat-unstable
pkgver=0.2.6+git20261010214240.1ab750a
pkgrel=1
pkgdesc="Free and open source video editor (main-branch snapshot)"
arch=('x86_64')
url="https://github.com/jub0t/concat"
license=('AGPL-3.0-or-later')
# Pinned snapshot; update.sh advances base_version/gitdate/shortcommit + pkgver
# + _commit together (same bump that refreshes the unified tarball below).
_commit=1ab750a339c5db249d353b21b9f3cc9ddb1a1a22
#
# UNIFIED TARBALL REUSE (no vendor step needed): source=() names the SAME
# update.sh-assembled snapshot tarball the RPM/.dsc recipes build from
# (upstream tree at $_commit + vendored crates + .cargo/config + the four
# x86_64 sidecars: BtbN FFmpeg 8.1, onnxruntime 1.28.0, Skia binary cache,
# sherpa-onnx statics; top dir concat-<commit>/). The file rides the OBS
# package sources (uploaded for the RPM side), so makepkg unpacks it from
# the build root instead of fetching a URL - no network at build time.
# Bare filename is intentional: OBS ignores local files for *scheduling*
# but still ships package sources into the Arch build root.
# update.sh maintenance on every bump: refresh the tarball, rename this
# entry to the new concat-unstable-<ver>.tar.gz, keep pkgver/_commit in
# sync, and fill the real sha256 (makepkg -g on the assembled tarball).
source=("concat-unstable-0.2.6+git20261010214240.1ab750a.tar.gz")
# Best-effort mapping of the spec's BuildRequires to Arch makedepends (gcc/make/
# pkgconf come from base-devel, §4.1). Arch has no standalone `cargo`
# package (`pacman -Si cargo` = missing; `rust` provides cargo) - use rust.
# clang supplies libclang for bindgen.
makedepends=('rust' 'cmake' 'clang' 'openssl' 'fontconfig' 'freetype2'
             'libxkbcommon' 'libxkbcommon-x11' 'mesa' 'gtk3' 'alsa-lib'
             'desktop-file-utils' 'zstd')
# 'zstd' supplies -lzstd at link time: sherpa-onnx-sys's build script links
# system -llzma -lbz2 -lzstd for its static lib (proven 2026-10-11: without
# it ld.lld fails on undefined ZSTD_* symbols from zip/zstd-safe rlibs).
# System runtime libs mirroring the spec's Requires. Bundled libav*/libonnxruntime
# land under /opt/concat-unstable/lib and are deliberately NOT turned into system
# deps (mirrors the spec's __requires_exclude_from ^/opt/...); confirm the final
# set with find-libdeps/namcap once the package builds.
depends=('mesa' 'fontconfig' 'gtk3' 'alsa-lib' 'freetype2' 'libxkbcommon'
         'libxkbcommon-x11' 'openssl' 'hicolor-icon-theme' 'zstd')
# ^ zstd at runtime too: the binary now links system libzstd.so.1 directly.
# update.sh: refresh the tarball name + real sha256 on every pin bump
# (sha256sum the assembled unified tarball; docs/arch-packaging.md §7).
sha256sums=('SKIP')

prepare() {
  local root="$srcdir/concat-$_commit"
  # cargo-1.99 does not forward ring's cargo:rustc-link-lib into
  # build-script link lines (its C core then stays undefined at link).
  # Patch the VENDORED ring build script to additionally emit
  # cargo:rustc-link-arg, which travels the dependency-scoped channel.
  # Version-guarded: fails loudly if ring's source changes shape.
  local ring_rs="$root/src/vendor/ring/build.rs"
  grep -q 'println!("cargo:rustc-link-lib=static={}", lib_name);' "$ring_rs" \
    || return 1
  grep -q 'cargo:rustc-link-arg=-lring_core' "$ring_rs" && return 0
  sed -i 's|println!("cargo:rustc-link-lib=static={}", lib_name);|println!("cargo:rustc-link-lib=static={}", lib_name);\n    println!("cargo:rustc-link-arg=-l{}", lib_name);|' "$ring_rs"
  grep -q 'cargo:rustc-link-arg=-l{}' "$ring_rs" || return 1
}

build() {
  local root="$srcdir/concat-$_commit"
  # Emit the shipped .desktop here so check() can validate it and package()
  # installs one copy. Arch runs build() -> check() -> package(); the RPM
  # %check validated the already-installed copy, which does not exist at
  # check() time in Arch.
  cat > "$srcdir/concat-unstable.desktop" <<'EOF'
[Desktop Entry]
Type=Application
Name=Concat (Unstable)
Comment=Video editor - main branch snapshot
Exec=/usr/bin/concat-unstable %U
Icon=concat-unstable
Terminal=false
Categories=AudioVideo;Video;
EOF

  # Offline vendored build; env mirrors upstream's Linux CI. BtbN FFmpeg via
  # FFMPEG_DIR, Microsoft ONNX via ORT_LIB_LOCATION + dynamic link, Skia via the
  # prefetched file:// cache, sherpa-onnx statics via SHERPA_ONNX_ARCHIVE_DIR,
  # and an $ORIGIN/lib DT_RPATH so the bundled libs resolve transitively.
  export CARGO_NET_OFFLINE=true
  export ORT_SKIP_DOWNLOAD=1
  export FFMPEG_DIR="$root/ffmpeg-dev"
  export ORT_LIB_LOCATION="$root/onnxlib"
  export ORT_PREFER_DYNAMIC_LINK=1
  export SKIA_BINARIES_URL="file://$root/skia-cache/skia-binaries-b7f043e0b1e2a850e702-x86_64-unknown-linux-gnu-ganesh-gl-jpegd-jpege-pdf-vulkan.tar.gz"
  export SHERPA_ONNX_ARCHIVE_DIR="$root/sherpa-cache"
  export RUSTFLAGS="-C link-arg=-Wl,-rpath,\$ORIGIN/lib -C link-arg=-Wl,--disable-new-dtags -C link-arg=-Wl,--no-as-needed -C link-arg=-lzstd -C link-arg=-Wl,--as-needed -C link-arg=-fuse-ld=bfd"
# ^ explicit -lzstd wrapped to survive --as-needed: zip/zstd-safe rlibs need
# system libzstd at final link. GNU ld (TW) resolves it transitively, but this
# recipe links with lld (-fuse-ld=lld, set by sherpa-onnx-sys), which errors on
# otherwise-undefined ZSTD_* symbols (proven 2026-10-11 over two OBS builds:
# zstd installed, bare -lzstd present on the link line, symbols still
# unresolved - as-needed dropped it before use).
# ^ -fuse-ld=bfd: the Arch worker toolchain defaults to lld (flag present in
# every OBS Arch link line, origin unknown - not in the vendor tree); bfd
# tolerates transitive shared-undefined like TW's linker does.
# ^ -lring_core_0_17_14 REMOVED 2026-10-11: a global -l breaks every
# build-script link whose -L lacks ring's OUT_DIR (quote failed on it).
# The missing native lib is a cargo-1.99 link-propagation gap (ring's own
# cargo:rustc-link-lib never reaches build-script links); instead the
# vendored ring build script is patched below in prepare() to ALSO emit
# cargo:rustc-link-arg, which propagates through the proper
# dependency-scoped channel. See prepare().

  cd "$root/src" || return 1
  cargo build --offline --frozen --release --bin concat
}

check() {
  desktop-file-validate "$srcdir/concat-unstable.desktop"
}

package() {
  local root="$srcdir/concat-$_commit"

  install -dm755 "$pkgdir/opt/concat-unstable/lib"
  install -m0755 "$root/src/target/release/concat" \
    "$pkgdir/opt/concat-unstable/concat-unstable"
  cp -a "$root"/ffmpeg-dev/lib/lib*.so* "$pkgdir/opt/concat-unstable/lib/"
  cp -a "$root"/onnxlib/libonnxruntime.so* "$pkgdir/opt/concat-unstable/lib/"

  install -dm755 "$pkgdir/usr/bin"
  cat > "$pkgdir/usr/bin/concat-unstable" <<'EOF'
#!/bin/sh
exec /opt/concat-unstable/concat-unstable "$@"
EOF
  chmod 0755 "$pkgdir/usr/bin/concat-unstable"

  install -Dm644 "$srcdir/concat-unstable.desktop" \
    "$pkgdir/usr/share/applications/concat-unstable.desktop"

  install -Dm644 "$root/assets/icons/concat_logo_256.png" \
    "$pkgdir/usr/share/icons/hicolor/256x256/apps/concat-unstable.png"

  install -Dm644 "$root/LICENSE" \
    "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
