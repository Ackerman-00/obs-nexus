#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_configure:
	:

override_dh_auto_build:
	:

override_dh_auto_test:
	:
	:
	:
	:

override_dh_shlibdeps:
	:

override_dh_auto_install:
	mkdir -p payload
	cd payload && ar x "$$(ls ../*.deb)" 2>/dev/null; cd ..
	if [ -f payload/data.tar.gz ]; then \
	    tar -xzf payload/data.tar.gz -C payload; \
	elif [ -f payload/data.tar.xz ]; then \
	    tar -xJf payload/data.tar.xz -C payload; \
	elif [ -f payload/data.tar.zst ]; then \
	    tar --zstd -xf payload/data.tar.zst -C payload; \
	else \
	    echo "ERROR: unexpected data.tar compression in upstream DEB"; exit 1; \
	fi
	mkdir -p debian/concat/opt/concat debian/concat/usr/bin debian/concat/usr/share
	cp -a payload/opt/concat/* debian/concat/opt/concat/
	cp -a payload/usr/bin/concat debian/concat/usr/bin/concat
	cp -a payload/usr/share/applications debian/concat/usr/share/
	cp -a payload/usr/share/icons debian/concat/usr/share/
	cp -a payload/usr/share/doc debian/concat/usr/share/
	sed -i 's|^Exec=.*|Exec=/usr/bin/concat %U|' debian/concat/usr/share/applications/concat.desktop
