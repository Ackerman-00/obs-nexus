# Maintainer: Ackerman-00
pkgname=filmcraft
pkgver=0.5.0
pkgrel=1
pkgdesc="Video editor - clean-room Premiere Pro in pure Rust"
arch=('x86_64')
url="https://github.com/storytold/filmcraft"
license=('MIT' 'Apache-2.0')
source=("https://github.com/storytold/filmcraft/releases/download/v0.5.0/filmcraft-0.5.0-linux-x86_64.rpm")
sha256sums=('SKIP') # update.sh refreshes via makepkg -g on bump
makedepends=('cpio')
depends=('alsa-lib' 'hicolor-icon-theme' 'libglvnd' 'vulkan-icd-loader' 'libxkbcommon')
noextract=("filmcraft-0.5.0-linux-x86_64.rpm")

package() {
	cd "$srcdir"
	bsdtar -xf "filmcraft-0.5.0-linux-x86_64.rpm"

	install -Dm755 usr/bin/filmcraft "$pkgdir/usr/bin/filmcraft"
	install -Dm755 usr/bin/filmcraft-cli "$pkgdir/usr/bin/filmcraft-cli"

	install -dm755 "$pkgdir/usr/share"
	cp -a usr/share/applications "$pkgdir/usr/share/"
	cp -a usr/share/icons "$pkgdir/usr/share/"
	cp -a usr/share/metainfo "$pkgdir/usr/share/"
	cp -a usr/share/mime "$pkgdir/usr/share/"
	cp -a usr/share/doc "$pkgdir/usr/share/"
}
