#!/usr/bin/make -f
# Debian repack of the upstream filmcraft .deb (binary re-distributor,
# same file policy as the RPM spec: /usr hierarchy installed verbatim -
# upstream already ships correct FHS layout with PATH-based Exec).
# Upstream's own Depends corrected for t64 (libasound2 -> libasound2t64).
# No network at build time: the orig tarball holds the upstream .deb,
# opened here with binutils ar + tar (data.tar may be .gz/.xz/.zst).
%:
	dh $@

override_dh_auto_configure:
	:

override_dh_auto_build:
	:

override_dh_auto_test:
	: # no-op: validating debian/<pkg>/... here runs BEFORE auto_install
	: # stages the payload (same ordering trap concat documents); the
	: # desktop entry is validated by the RPM %check instead.

# Binary repack with a DT_NEEDED system lib (libasound.so.2) whose
# -dev shlibs are not in Build-Depends, so automatic shlibdeps
# analysis cannot run; the manually maintained Depends (libasound2t64,
# verified against the upstream .deb control file) IS the dependency
# declaration. Same pattern as concat's no-op override.
override_dh_shlibdeps:
	:

override_dh_auto_install:
	mkdir -p payload
	cd payload && ar x "$$(ls ../*.deb)" 2>/dev/null; cd ..
	if [ -f payload/data.tar.gz ]; then \
	    tar -xzf payload/data.tar.gz -C payload; \
	elif [ -f payload/data.tar.xz ]; then \
	    tar -xJf payload/data.tar.xz -C payload; \
	elif [ -f payload/data.tar.zst ]; then \
	    tar --zstd -xf payload/data.tar.zst -C payload; \
	else \
	    echo "ERROR: unexpected data.tar compression in upstream DEB"; exit 1; \
	fi
	mkdir -p debian/filmcraft/usr/bin debian/filmcraft/usr/share
	cp -a payload/usr/bin/* debian/filmcraft/usr/bin/
	cp -a payload/usr/share/applications debian/filmcraft/usr/share/
	cp -a payload/usr/share/icons debian/filmcraft/usr/share/
	cp -a payload/usr/share/metainfo debian/filmcraft/usr/share/
	cp -a payload/usr/share/mime debian/filmcraft/usr/share/
	cp -a payload/usr/share/doc debian/filmcraft/usr/share/
