#!/usr/bin/make -f
GHOSTTY_VER = $(shell cat $(CURDIR)/src/VERSION 2>/dev/null || cat $(CURDIR)/VERSION 2>/dev/null)
ZIG = $(CURDIR)/zig/zig
ZCACHE = $(CURDIR)/vendor/zig
ZFLAGS = --system $(ZCACHE)/p -Doptimize=ReleaseFast -Dcpu=baseline -Dpie=true -Dstrip=true -Dversion-string=$(GHOSTTY_VER) -fsys=freetype -fsys=harfbuzz -fsys=fontconfig -fsys=libpng -fsys=zlib -fsys=oniguruma -fsys=spirv-cross -fsys=simdutf -fsys=gtk4-layer-shell -fsys=highway

%:
	dh $@

override_dh_auto_clean:
	mkdir -p debian/source; \
	printf '%s\n' 'extend-diff-ignore = "src/zig-out/.*"' 'extend-diff-ignore = "src/zig-cache/.*"' 'extend-diff-ignore = "src/.zig-cache/.*"' 'extend-diff-ignore = "obj-.*/.*"' > debian/source/options; \
	dh_auto_clean

override_dh_auto_configure:
	:

override_dh_auto_build:
	:
override_dh_auto_test:
	:

override_dh_auto_install:
	mkdir -p debian/ghostty && \
	ZIG_GLOBAL_CACHE_DIR=$(ZCACHE) DESTDIR=$(CURDIR)/debian/ghostty $(ZIG) build --prefix /usr --prefix-lib-dir lib/x86_64-linux-gnu $(ZFLAGS) && \
	rm -rv $(CURDIR)/debian/ghostty/usr/share/terminfo/ && \
	rm -v $(CURDIR)/debian/ghostty/usr/lib/x86_64-linux-gnu/libghostty-vt.a \
	      $(CURDIR)/debian/ghostty/usr/lib/x86_64-linux-gnu/libghostty-vt.so \
	      $(CURDIR)/debian/ghostty/usr/lib/x86_64-linux-gnu/libghostty-vt.so.0 \
	      $(CURDIR)/debian/ghostty/usr/lib/x86_64-linux-gnu/libghostty-vt.so.0.1.0 \
	      $(CURDIR)/debian/ghostty/usr/lib/x86_64-linux-gnu/libghostty-vt.pc \
	      $(CURDIR)/debian/ghostty/usr/lib/x86_64-linux-gnu/pkgconfig/libghostty-vt.pc \
	      $(CURDIR)/debian/ghostty/usr/share/pkgconfig/libghostty-vt.pc \
	      $(CURDIR)/debian/ghostty/usr/share/pkgconfig/libghostty-vt-static.pc \
	      $(CURDIR)/debian/ghostty/usr/lib/x86_64-linux-gnu/libghostty-vt-static.pc 2>/dev/null || true && \
	rm -rv $(CURDIR)/debian/ghostty/usr/include/ghostty 2>/dev/null || true && \
	mv $(CURDIR)/debian/ghostty/usr/share/pkgconfig/ $(CURDIR)/debian/ghostty/usr/lib/x86_64-linux-gnu/ || true
