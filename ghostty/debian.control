Source: ghostty
Section: x11
Priority: optional
Maintainer: Ackerman-00 <noreply@example.com>
Build-Depends: debhelper-compat (= 13), build-essential, gcc-multilib, cmake, pkgconf, pandoc, gettext, desktop-file-utils, appstream, gobject-introspection, python3, hicolor-icon-theme, libxml2-utils, bash-completion, libbz2-dev, libcairo2-dev, libgdk-pixbuf-2.0-dev, libglib2.0-dev, libgraphene-1.0-dev, libgtk-4-dev, libgtk4-layer-shell-dev, libharfbuzz-dev, libadwaita-1-dev, libhwy-dev, libpng-dev, libncurses-dev, libonig-dev, libpango1.0-dev, libpixman-1-dev, libsimdutf-dev, libspirv-cross-c-shared-dev, libsystemd-dev, libvulkan-dev, zlib1g-dev, glslang-dev
Standards-Version: 4.7.0
Rules-Requires-Root: no
Homepage: https://github.com/ghostty-org/ghostty

Package: ghostty
Architecture: amd64
# shlibdeps + terminfo; nautilus ext stays opt-in
Depends: ${shlibs:Depends}, ${misc:Depends}, hicolor-icon-theme, ncurses-term
Recommends: python3-nautilus
Description: Cross-platform terminal emulator
 Ghostty is a fast, feature-rich, and cross-platform terminal emulator
 that uses platform-native UI and GPU acceleration.
