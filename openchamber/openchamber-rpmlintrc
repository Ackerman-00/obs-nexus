# Bundled prebuilt Electron runtime under /opt/openchamber is immutable
# upstream binaries - these findings describe upstream's own files,
# not packaging mistakes. Same pattern as obsidian/vesktop/stoat-desktop
# (verified against the 2.2.0 TW build log: 36 E:, badness 120122).
addFilter("binary-or-shlib-defines-rpath")
addFilter("filelist-forbidden-opt")
# Private bundled libs under /opt/openchamber/usr/lib (legacy tray libs
# the AppImage carries for old distros; never in ldconfig path, never +x
# upstream): not ours to chmod or register. Same as obsidian.
addFilter("shared-library-not-executable")
addFilter("missing-hash-section")
addFilter("library-without-ldconfig-postin")
addFilter("library-without-ldconfig-postun")
# Upstream data files inside the bundled app.asar node_modules tree
# (bun-pty .bun-tag, msgpackr index.js) and node-pty win headers.
addFilter("devel-file-in-non-devel-package")
# Upstream bundles ripgrep (rg) as a static-pie musl binary at
# /opt/openchamber/resources/ripgrep/rg and invokes it from that fixed
# path - identical BuildID (2b383d94...) in the 2.4.0 and 2.5.0
# AppImages (both extracted and file(1)-verified 2026-10-20), i.e.
# upstream's own file, not a packaging mistake. Official ripgrep
# releases are static musl by design; swapping in the distro rg would
# change which binary the app executes. Same upstream-payload class as
# the filters above (obsidian/vesktop precedent).
addFilter("statically-linked-binary")
# zero-length filter DROPPED 2026-10-14: rpmlint E: unused-rpmlintrc-filter
# (the 2.3.2 payload ships no zero-length files anymore - verified by
# rpm2cpio + find -size 0 over the built 2.3.2-26.1 TW RPM: none). Unused
# filters are themselves errors; re-add only if a future payload brings
# zero-length files back.
# hicolor-icon-theme is intentionally unversioned (repo convention,
# same as every other spec in this repo).
addFilter("branding-requires-unversioned")

# unstripped-binary-or-object: openSUSE:Packaging_checks says of this rule
# "This error should actually never show up in the build service. The build
# script automatically strips binaries according to global project
# settings" and "Please do not strip binaries manually as that will break
# debuginfo creation"; Packaging_guidelines confirms the sanctioned remedy
# is to suppress a false positive. rpmlint.opensuse.org reports this same
# warning on 239 openSUSE:Factory packages, so it is systemic, not a defect
# here. The flagged ELFs are upstream Electron/Chromium payload files shipped byte-for-byte; rewriting them would alter the shipped artifact.
addFilter("unstripped-binary-or-object")
