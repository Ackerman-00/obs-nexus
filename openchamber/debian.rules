#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_configure:
	:

override_dh_auto_build:
	:

override_dh_auto_test:
	:
	:
	:
	:

override_dh_auto_install:
	chmod +x "$$(ls *.AppImage)" && ./"$$(ls *.AppImage)" --appimage-extract >/dev/null && mv squashfs-root appimage-root
	mkdir -p debian/openchamber/opt/openchamber debian/openchamber/usr/bin debian/openchamber/usr/share/applications
	cp -ar appimage-root/* debian/openchamber/opt/openchamber/
	chmod 0755 debian/openchamber/opt/openchamber/chrome-sandbox
	printf '#!/bin/sh\nexport APPDIR="/opt/openchamber"\nexec /opt/openchamber/AppRun "$$@"\n' > debian/openchamber/usr/bin/openchamber
	chmod 0755 debian/openchamber/usr/bin/openchamber
	sed -e 's|^Exec=.*|Exec=/usr/bin/openchamber %U|' -e 's|^Icon=.*|Icon=openchamber|' \
	    appimage-root/openchamber.desktop > debian/openchamber/usr/share/applications/openchamber.desktop
	install -Dm644 appimage-root/openchamber.png debian/openchamber/usr/share/icons/hicolor/256x256/apps/openchamber.png

override_dh_shlibdeps:
	:

override_dh_strip:
	:

override_dh_dwz:
	:
