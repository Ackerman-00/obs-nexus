#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_configure:
	:

override_dh_auto_build:
	:

override_dh_auto_test:
	:

override_dh_fixperms:
	dh_fixperms
	chmod 4755 debian/openchamber/opt/OpenChamber/chrome-sandbox

override_dh_auto_install:
	mkdir -p payload
	cd payload && (ar x ../*.deb data.tar.gz data.tar.xz data.tar.zst 2>/dev/null || true); cd ..
	if [ -f payload/data.tar.xz ]; then tar -xpf payload/data.tar.xz -C payload; \
	elif [ -f payload/data.tar.zst ]; then tar --zstd -xpf payload/data.tar.zst -C payload; \
	elif [ -f payload/data.tar.gz ]; then tar -xzf payload/data.tar.gz -C payload; \
	else echo "ERROR: unexpected data.tar compression"; exit 1; fi
	mkdir -p debian/openchamber/opt debian/openchamber/usr
	cp -a payload/opt/OpenChamber debian/openchamber/opt/
	cp -a payload/usr/share debian/openchamber/usr/
	find debian/openchamber \( -path '*/resources/app-update.yml' -o -path '*/resources/package-type' \) -delete

override_dh_shlibdeps:
	:

override_dh_strip:
	:

override_dh_dwz:
	:
