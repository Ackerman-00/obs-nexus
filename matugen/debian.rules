#!/usr/bin/make -f
# Debian build of upstream matugen (Rust, fully vendored offline build,
# same policy as the RPM spec: cargo --offline --frozen --release against
# the vendored crates + source-replacement config update.sh generates).
# No network at build time: the orig tarball IS the upstream source
# archive; vendor.tar.xz + cargo_config ride in via Debtransform-Files-Tar
# / Debtransform-Files and land at the source root (vendor/, cargo_config).
%:
	dh $@

override_dh_auto_configure:
	:; \
	mkdir -p debian/source; \
	printf '%s\n' 'extend-diff-ignore = "vendor/.*"' 'extend-diff-ignore = "cargo_config"' 'extend-diff-ignore = ".cargo/.*"' 'extend-diff-ignore = "target/.*"' > debian/source/options
# NOTE (2026-10-09): vendor/ + cargo_config arrive via the .dsc's
# Debtransform-Files-Tar/Files merge, so dpkg-source -b would treat them
# as new upstream files and abort on their binaries ("cannot represent
# changes ... add in debian/source/include-binaries"). The generated
# debian/source/options above excludes them (plus build outputs) from
# the regenerated debian tar instead -- the flat debian.* channel cannot
# carry debian/source/* files, so the rules generate it every build.

override_dh_auto_build:
	mkdir -p .cargo && cp cargo_config .cargo/config
	cargo build --offline --frozen --release

override_dh_auto_test:
	:

override_dh_auto_install:
	install -Dm0755 target/release/matugen debian/matugen/usr/bin/matugen

override_dh_auto_clean:
	rm -rf target .cargo
