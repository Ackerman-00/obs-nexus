#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_configure:
	:

override_dh_auto_build:
	:

override_dh_shlibdeps:
	:

override_dh_dwz:
	:

override_dh_auto_test:
	:

override_dh_auto_install:
	mkdir -p payload
	cd payload && (ar x ../*.deb data.tar.gz data.tar.xz data.tar.zst 2>/dev/null || true); cd ..
	if [ -f payload/data.tar.gz ]; then tar -xzf payload/data.tar.gz -C payload; \
	elif [ -f payload/data.tar.xz ]; then tar -xf payload/data.tar.xz -C payload; \
	elif [ -f payload/data.tar.zst ]; then tar --zstd -xf payload/data.tar.zst -C payload; \
	else echo "ERROR: unexpected data.tar compression"; exit 1; fi
	mkdir -p debian/hyperframes-desktop/opt debian/hyperframes-desktop/usr/share debian/hyperframes-desktop/usr/bin
	cp -a payload/opt/hyperframes debian/hyperframes-desktop/opt/
	cp -a payload/usr/share/* debian/hyperframes-desktop/usr/share/
	if [ -L payload/usr/bin/hyperframes ] || [ -e payload/usr/bin/hyperframes ]; then ln -sf /opt/hyperframes/HyperFrames debian/hyperframes-desktop/usr/bin/hyperframes; fi
