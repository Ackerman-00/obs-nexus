# Maintainer: Ackerman-00
# X11/wayland/xkbcommon-x11 are linked (not dlopened) here: ship the
# binaries as released, no makepkg strip.
pkgname=photocraft
pkgver=0.6.0
pkgrel=1
pkgdesc="Photo editor - clean-room Photoshop in pure Rust"
arch=('x86_64')
url="https://github.com/storytold/photocraft"
license=('MIT' 'Apache-2.0')
source=("https://github.com/storytold/photocraft/releases/download/v${pkgver}/photocraft-${pkgver}-linux-x86_64.rpm")
sha256sums=('SKIP') # update.sh refreshes via makepkg -g on bump
makedepends=('libarchive')
depends=('hicolor-icon-theme' 'gcc-libs' 'libx11' 'libxcursor' 'libxi' 'vulkan-icd-loader' 'libegl' 'wayland' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11')
noextract=("photocraft-${pkgver}-linux-x86_64.rpm")
options=('!strip')

package() {
	cd "$srcdir"
	bsdtar -xf "photocraft-${pkgver}-linux-x86_64.rpm"

	install -Dm755 usr/bin/photocraft "$pkgdir/usr/bin/photocraft"
	install -Dm755 usr/bin/photocraft-cli "$pkgdir/usr/bin/photocraft-cli"

	install -dm755 "$pkgdir/usr/share"
	cp -a usr/share/applications usr/share/icons usr/share/metainfo \
		usr/share/mime usr/share/doc "$pkgdir/usr/share/"

	install -dm755 "$pkgdir/usr/share/licenses/$pkgname"
	install -m644 usr/share/doc/photocraft/LICENSE-APACHE \
		usr/share/doc/photocraft/LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/"
}
