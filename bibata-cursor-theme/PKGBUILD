# Maintainer: Ackerman-00
# Arch recipe mirroring bibata-cursor-theme.spec (data, noarch).
pkgname=bibata-cursor-theme
pkgver=2.0.7
pkgrel=1
pkgdesc="Open source, compact, and material designed cursor set"
arch=('any')
url="https://github.com/ful1e5/Bibata_Cursor"
license=('GPL-3.0-or-later')
source=("https://github.com/ful1e5/Bibata_Cursor/releases/download/v${pkgver}/Bibata.tar.xz")
# update.sh: run `updpkgsums` (or `makepkg -g`) before commit to fill sums.
# SRI-verified sum is not committed here because OBS neither gates nor
# verifies Arch checksums and this recipe is static (docs/arch-packaging.md §7).
sha256sums=('SKIP')

package() {
  cd "$srcdir" || return 1
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -dm755 "$pkgdir/usr/share/icons"
  mv Bibata-* "$pkgdir/usr/share/icons/"
}
