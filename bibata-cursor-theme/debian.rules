#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_configure:
	:

override_dh_auto_build:
	:

override_dh_auto_test:
	:

override_dh_auto_install:
	mkdir -p debian/bibata-cursor-theme/usr/share/icons
	mv Bibata-* debian/bibata-cursor-theme/usr/share/icons/
	command -v fdupes >/dev/null && fdupes -r debian/bibata-cursor-theme/usr/share/icons || true
