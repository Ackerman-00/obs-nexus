Source: rootapp
Section: net
Priority: optional
Maintainer: Ackerman-00 <quietcraft@gmail.com>
Build-Depends: debhelper-compat (= 13)
Standards-Version: 4.7.0
Rules-Requires-Root: no
Homepage: https://www.rootapp.com

Package: rootapp
Architecture: amd64
# Runtime set mapped from the RPM spec's Requires (t64 names target Debian
# Testing; the ayatana stack is unchanged by the time_t transition).
Depends: ${misc:Depends}, hicolor-icon-theme, libasound2t64, libatk1.0-0t64, libatk-bridge2.0-0t64, libatspi2.0-0, libegl1, libgbm1, libgtk-3-0t64, libnotify4, libpulse0, libvulkan1, libwayland-client0, libwayland-cursor0, libwayland-egl1, libx11-6, libxcb1, libxcomposite1, libxcursor1, libxdamage1, libxkbcommon0, libxrandr2, libxrender1, libxss1, libxt6, libxtst6, libnspr4, libnss3, wl-clipboard, xdg-utils
Description: Discord alternative for gaming communities and large groups
 Root App is a new Discord alternative, designed for gaming communities
 and large online groups.
