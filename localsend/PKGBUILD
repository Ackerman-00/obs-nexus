# Maintainer: Ackerman-00
# Arch repack of the upstream LocalSend .deb, mirroring localsend.spec %install.
pkgname=localsend
pkgver=1.18.2
pkgrel=1
pkgdesc="An open source cross-platform alternative to AirDrop"
arch=('x86_64')
url="https://github.com/localsend/localsend"
license=('GPL-3.0-only')
depends=(
	'at-spi2-core'
	'cairo'
	'fontconfig'
	'gdk-pixbuf2'
	'glib2'
	'gtk3'
	'hicolor-icon-theme'
	'libayatana-appindicator'
	'libepoxy'
	'pango'
	'xdg-user-dirs'
)
makedepends=('binutils' 'tar' 'zstd')
options=('!strip')
source=("https://github.com/localsend/localsend/releases/download/v${pkgver}/LocalSend-${pkgver}-linux-x86-64.deb")
sha256sums=('SKIP') # update.sh refreshes via makepkg -g on bump
noextract=("LocalSend-${pkgver}-linux-x86-64.deb")

package() {
	cd "$srcdir" || return 1

	ar x "LocalSend-${pkgver}-linux-x86-64.deb" || return 1
	if [[ -f data.tar.xz ]]; then
		tar xf data.tar.xz || return 1
	elif [[ -f data.tar.zst ]]; then
		tar --zstd -xf data.tar.zst || return 1
	else
		echo "ERROR: unexpected data.tar compression in upstream DEB" >&2
		return 1
	fi

	install -dm755 "$pkgdir/usr/share" "$pkgdir/opt"
	cp -a usr/share/. "$pkgdir/usr/share/"
	cp -a opt/localsend_app "$pkgdir/opt/"

	# Upstream DEB ships no /usr/bin entry, only the Exec=localsend_app desktop key.
	install -dm755 "$pkgdir/usr/bin"
	cat >"$pkgdir/usr/bin/localsend_app" <<'EOF'
#!/bin/sh
exec /opt/localsend_app/localsend_app "$@"
EOF
	chmod 0755 "$pkgdir/usr/bin/localsend_app"
}
