Source: xdg-desktop-portal-umbriel-git
Section: x11
Priority: optional
Maintainer: Ackerman-00 <noreply@example.com>
Build-Depends: debhelper-compat (= 13), meson, ninja-build, pkg-config,
 libsdbus-c++-dev, libpipewire-0.3-dev, libwayland-dev,
 libwayland-bin, wayland-protocols (>= 1.39),
 libdrm-dev, libgbm-dev, libcairo2-dev, nlohmann-json3-dev,
 libtomlplusplus-dev, libgtk-4-dev, libglib2.0-dev, libei-dev,
 libegl-dev, libgles-dev, libfontconfig-dev, libfreetype-dev,
 libharfbuzz-dev, libpango1.0-dev, libxkbcommon-dev, libstb-dev
Standards-Version: 4.7.0
Rules-Requires-Root: no
Homepage: https://github.com/noctalia-dev/xdg-desktop-portal-umbriel

Package: xdg-desktop-portal-umbriel-git
Architecture: amd64
Depends: ${shlibs:Depends}, ${misc:Depends}, xdg-desktop-portal
Recommends: slurp
Conflicts: xdg-desktop-portal-umbriel
Replaces: xdg-desktop-portal-umbriel
Provides: xdg-desktop-portal-umbriel
Description: XDG desktop portal backend for the Umbriel compositor
 Implements xdg-desktop-portal screencast, screenshot, and input-capture
 interfaces for the Umbriel Wayland compositor, with a GTK4 share picker.
