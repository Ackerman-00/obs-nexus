#!/usr/bin/make -f
# Debian repack of the upstream artcraft-launcher .deb (binary
# re-distributor, same file policy as the RPM spec: /usr hierarchy
# installed verbatim - upstream already ships correct FHS layout).
# Upstream's own Depends verified correct (t64-era names need no
# adjustment), with the vulkan/egl alternative spelled out explicitly.
# No network at build time: the orig tarball holds both arch .debs,
# opened here with binutils ar + tar (data.tar may be .gz/.xz/.zst).
%:
	dh $@

override_dh_auto_configure:
	:

override_dh_auto_build:
	:

override_dh_auto_test:
	: # no-op: validating debian/<pkg>/... here runs BEFORE auto_install
	: # stages the payload (same ordering trap cadcraft documents); the
	: # desktop entry is validated by the RPM %check instead.

override_dh_auto_install:
	mkdir -p payload
	ARCH=$$(dpkg-architecture -qDEB_HOST_ARCH); \
	if [ "$$ARCH" = amd64 ]; then UPDEB=$$(ls *-linux-x86_64.deb 2>/dev/null | head -n1); \
	elif [ "$$ARCH" = arm64 ]; then UPDEB=$$(ls *-linux-aarch64.deb 2>/dev/null | head -n1); \
	else echo "ERROR: unsupported DEB_HOST_ARCH $$ARCH (expected amd64 or arm64)"; exit 1; fi; \
	if [ -z "$$UPDEB" ]; then UPDEB=$$(ls *.deb 2>/dev/null | head -n1); fi; \
	if [ -z "$$UPDEB" ]; then echo "ERROR: no upstream .deb in orig wrapper"; exit 1; fi; \
	cd payload && ar x "../$$UPDEB" 2>/dev/null; cd ..
	if [ -f payload/data.tar.gz ]; then \
	    tar -xzf payload/data.tar.gz -C payload; \
	elif [ -f payload/data.tar.xz ]; then \
	    tar -xJf payload/data.tar.xz -C payload; \
	elif [ -f payload/data.tar.zst ]; then \
	    tar --zstd -xf payload/data.tar.zst -C payload; \
	else \
	    echo "ERROR: unexpected data.tar compression in upstream DEB"; exit 1; \
	fi
	mkdir -p debian/artcraft-launcher/usr/bin debian/artcraft-launcher/usr/share
	cp -a payload/usr/bin/* debian/artcraft-launcher/usr/bin/
	cp -a payload/usr/share/applications debian/artcraft-launcher/usr/share/
	cp -a payload/usr/share/icons debian/artcraft-launcher/usr/share/
	cp -a payload/usr/share/metainfo debian/artcraft-launcher/usr/share/
	cp -a payload/usr/share/doc debian/artcraft-launcher/usr/share/
