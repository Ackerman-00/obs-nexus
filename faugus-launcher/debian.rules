#!/usr/bin/make -f
# Debian build of upstream Faugus (pure Python + meson, same source as the
# RPM spec). Upstream ships no test suite, so the test step is a no-op.
# No network at build time: the orig tarball IS the upstream source archive.
%:
	dh $@

override_dh_auto_clean:
	mkdir -p debian/source; \
	printf '%s\n' 'extend-diff-ignore = "build/.*"' 'extend-diff-ignore = "build-native/.*"' 'extend-diff-ignore = "obj-.*/.*"' > debian/source/options; \
	dh_auto_clean
# NOTE: OBS runs dpkg-source -b right AFTER debian/rules clean and BEFORE
# configure, so the in-tree meson build-dir exclusion MUST be generated
# here (debian/source/options cannot ride the flat debian.* channel).

override_dh_auto_configure:
	dh_auto_configure --buildsystem=meson -- --prefix=/usr

override_dh_auto_build:
	dh_auto_build --buildsystem=meson

override_dh_auto_test:
	:

override_dh_auto_install:
	dh_auto_install --buildsystem=meson
