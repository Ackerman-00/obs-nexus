#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_configure:
	:

override_dh_auto_build:
	:

override_dh_auto_test:
	:

override_dh_shlibdeps:
	:

override_dh_dwz:
	:

override_dh_strip:
	:

override_dh_auto_install:
	mkdir -p debian/ladybird-unstable/opt debian/ladybird-unstable/usr/bin debian/ladybird-unstable/usr/share
	cp -a opt/ladybird debian/ladybird-unstable/opt/
	if [ -d usr/bin ]; then cp -a usr/bin/* debian/ladybird-unstable/usr/bin/; fi
	if [ -d usr/share ]; then cp -a usr/share/* debian/ladybird-unstable/usr/share/; fi

override_dh_installchangelogs:
	dh_installchangelogs --no-trim

override_dh_clean:
	dh_clean
