#!/usr/bin/make -f
SHELL := /bin/bash
HATTER_SRC := $(shell dirname "$$(find . -maxdepth 2 -name build.sh -not -path './debian/*' | head -n1)")
SHIM := $(CURDIR)/debian/.icon-cache-shim
DEST := $(CURDIR)/dist
%:
	dh $@

override_dh_auto_configure:
	mkdir -p "$(SHIM)"
	printf '#!/bin/sh\nexit 0\n' > "$(SHIM)/gtk-update-icon-cache"
	chmod 755 "$(SHIM)/gtk-update-icon-cache"

override_dh_auto_build:
	cd "$(HATTER_SRC)" && PATH="$(SHIM):$$PATH" bash ./build.sh --all --dest "$(DEST)"

override_dh_auto_test:
	:

override_dh_auto_install:
	mkdir -p debian/hatter-icon-theme/usr/share/icons
	for t in "$(DEST)"/*/; do \
	    [ -d "$$t" ] || continue; \
	    cp -a "$$t" "debian/hatter-icon-theme/usr/share/icons/$$(basename "$$t")"; \
	done
	find debian/hatter-icon-theme/usr/share/icons -name icon-theme.cache -delete
	find debian/hatter-icon-theme/usr/share/icons -xtype l -delete

override_dh_installchangelogs:
	dh_installchangelogs --no-trim

override_dh_clean:
	dh_clean
	rm -rf "$(DEST)" "$(SHIM)"
