# NOTE: permissions-* tags (setuid sandbox) can NOT be filtered - they are in
# rpmlint's BlockedFilters. chrome-sandbox stays setuid via the permissions
# profile + %post permctl call in the spec instead.
addFilter("binary-or-shlib-defines-rpath")
addFilter("filelist-forbidden-opt")
addFilter("explicit-lib-dependency")
addFilter("missing-call-to-setgroups-before-setuid")
addFilter("invalid-desktopfile")
