# Maintainer: Ackerman-00
# Arch repack of the upstream Zen tarball, mirroring zen-browser.spec %install.
# OBS ignores local source files, so the launcher, the desktop entry and
# policies.json are generated here instead of shipped as Source1/2/3.
pkgname=zen-browser
pkgver=1.23.2b
pkgrel=1
pkgdesc="Minimal browser focused on privacy and calm browsing"
arch=('x86_64')
url="https://github.com/zen-browser/desktop"
license=('MPL-2.0')
depends=(
	'alsa-lib'
	'at-spi2-core'
	'cairo'
	'dbus'
	'ffmpeg'
	'fontconfig'
	'freetype2'
	'gdk-pixbuf2'
	'glib2'
	'gtk3'
	'hicolor-icon-theme'
	'hunspell'
	'hyphen'
	'libx11'
	'libxcb'
	'libxcomposite'
	'libxcursor'
	'libxdamage'
	'libxext'
	'libxfixes'
	'libxi'
	'libxrandr'
	'libxrender'
	'libxt'
	'libpulse'
	'nspr'
	'nss'
	'pango'
)
optdepends=(
	'libnotify: notification integration'
	'networkmanager: location detection via available WiFi networks'
	'speech-dispatcher: text-to-speech'
	'xdg-desktop-portal: screensharing under Wayland'
)
makedepends=()
options=('!strip')
source=("https://github.com/zen-browser/desktop/releases/download/${pkgver}/zen.linux-x86_64.tar.xz")
sha256sums=('SKIP')

package() {
	install -dm755 "$pkgdir/usr/bin" \
		"$pkgdir/usr/share/applications" \
		"$pkgdir/usr/lib/zen-browser"

	cp -a "$srcdir/zen/." "$pkgdir/usr/lib/zen-browser/"
	rm -f "$pkgdir/usr/lib/zen-browser/removed-files"

	cat >"$pkgdir/usr/bin/zen-browser" <<'EOF'
#!/bin/sh
exec /usr/lib/zen-browser/zen-bin "$@"
EOF
	chmod 0755 "$pkgdir/usr/bin/zen-browser"

	cat >"$pkgdir/usr/share/applications/zen-browser.desktop" <<'EOF'
[Desktop Entry]
Name=Zen Browser
GenericName=Web Browser
Comment=Experience tranquillity while browsing the web without people tracking you!
Exec=/usr/bin/zen-browser %u
Icon=zen-browser
Type=Application
StartupWMClass=zen
Categories=Network;WebBrowser;
X-MultipleArgs=false
StartupNotify=true
Terminal=false
MimeType=text/html;text/xml;application/xhtml+xml;x-scheme-handler/http;x-scheme-handler/https;application/x-xpinstall;application/pdf;application/json;
Keywords=Internet;WWW;Browser;Web;Explorer;
Actions=new-window;new-private-window;profilemanager;

[Desktop Action new-window]
Name=Open a New Window
Exec=/usr/bin/zen-browser --new-window %u

[Desktop Action new-private-window]
Name=Open a New Private Window
Exec=/usr/bin/zen-browser --private-window %u

[Desktop Action profilemanager]
Name=Open the Profile Manager
Exec=/usr/bin/zen-browser --ProfileManager %u
EOF

	for size in 16x16 32x32 48x48 64x64 128x128; do
		install -Dm644 \
			"$pkgdir/usr/lib/zen-browser/browser/chrome/icons/default/default${size%x*}.png" \
			"$pkgdir/usr/share/icons/hicolor/$size/apps/zen-browser.png"
	done

	install -dm755 "$pkgdir/usr/lib/zen-browser/distribution"
	printf '%s\n' \
		'{' \
		'  "update": {' \
		'    "enabled": false,' \
		'    "auto": false,' \
		'    "managed_by": "package"' \
		'  }' \
		'}' >"$pkgdir/usr/lib/zen-browser/distribution/policies.json"

	ln -sf /usr/share/hunspell "$pkgdir/usr/lib/zen-browser/dictionaries"
	ln -sf /usr/share/hyphen "$pkgdir/usr/lib/zen-browser/hyphenation"

	# The bundled libnssckbi.so is dropped: the root CA module comes from the
	# system nss instead (same policy as the spec).
	rm -f "$pkgdir/usr/lib/zen-browser/libnssckbi.so"
	ln -sf /usr/lib/libnssckbi.so "$pkgdir/usr/lib/zen-browser/libnssckbi.so"
}
