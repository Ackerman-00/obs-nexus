#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_configure:
	:

override_dh_auto_build:
	:

override_dh_shlibdeps:
	:

override_dh_dwz:
	:

override_dh_auto_test:
	desktop-file-validate debian/zen-browser.desktop

override_dh_auto_install:
	mkdir -p debian/zen-browser/usr/bin debian/zen-browser/usr/share/applications debian/zen-browser/usr/lib/zen-browser
	find . -maxdepth 1 -mindepth 1 ! -name debian ! -name '.pc' -exec cp -a -t debian/zen-browser/usr/lib/zen-browser/ {} +
	rm -f debian/zen-browser/usr/lib/zen-browser/removed-files
	install -m0755 debian/zen-browser.sh debian/zen-browser/usr/bin/zen-browser
	desktop-file-install --dir=debian/zen-browser/usr/share/applications debian/zen-browser.desktop
	for size in 16x16 32x32 48x48 64x64 128x128; do \
	    num=$$(echo $$size | cut -dx -f1); \
	    install -Dm644 debian/zen-browser/usr/lib/zen-browser/browser/chrome/icons/default/default$$num.png \
	        debian/zen-browser/usr/share/icons/hicolor/$$size/apps/zen-browser.png; \
	done
	mkdir -p debian/zen-browser/usr/lib/zen-browser/distribution
	install -m644 debian/policies.json debian/zen-browser/usr/lib/zen-browser/distribution/policies.json
	ln -sf /usr/share/hunspell debian/zen-browser/usr/lib/zen-browser/dictionaries
	ln -sf /usr/share/hyphen debian/zen-browser/usr/lib/zen-browser/hyphenation
	rm -f debian/zen-browser/usr/lib/zen-browser/libnssckbi.so
	ln -sf /usr/lib/x86_64-linux-gnu/libnssckbi.so debian/zen-browser/usr/lib/zen-browser/libnssckbi.so
	if [ -f debian/zen-browser/usr/lib/zen-browser/libonnxruntime.so ]; then \
	    chrpath -d debian/zen-browser/usr/lib/zen-browser/libonnxruntime.so; \
	    if command -v execstack >/dev/null; then execstack -c debian/zen-browser/usr/lib/zen-browser/libonnxruntime.so; \
	    else echo "execstack not in buildroot (prelink retired), leaving libonnxruntime.so stack as shipped"; fi; \
	fi
