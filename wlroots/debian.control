Source: wlroots
Section: libs
Priority: optional
Maintainer: Ackerman-00 <noreply@example.com>
Build-Depends: debhelper-compat (= 13), meson, ninja-build, pkg-config,
 libwayland-dev, libwayland-bin, wayland-protocols (>= 1.47),
 libinput-dev, libxkbcommon-dev, libdrm-dev, libpixman-1-dev,
 libdisplay-info-dev, libliftoff-dev, libseat-dev, libudev-dev,
 libgbm-dev, libegl-dev, libgles-dev, libvulkan-dev, glslang-tools,
 liblcms2-dev, hwdata, xwayland, libxcb1-dev, libxcb-composite0-dev,
 libxcb-dri3-dev, libxcb-errors-dev, libxcb-ewmh-dev, libxcb-icccm4-dev,
 libxcb-present-dev, libxcb-render0-dev, libxcb-render-util0-dev,
 libxcb-res0-dev, libxcb-shm0-dev, libxcb-xfixes0-dev, libxcb-xinput-dev
Standards-Version: 4.7.0
Rules-Requires-Root: no
Homepage: https://gitlab.freedesktop.org/wlroots/wlroots

Package: wlroots
Architecture: amd64
# Same SONAME paths as Debian's own libwlroots-0.20 (identical upstream
# 0.20.2 ABI): declare the swap explicitly so apt replaces instead of
# colliding on libwlroots-0.20.so (OBS log proof 2026-10-11).
Provides: libwlroots-0.20
Conflicts: libwlroots-0.20
Replaces: libwlroots-0.20
# The .pc ships in this same binary (combined lib+dev): its
# Requires.private closure (see wlroots-0.20.pc) must be installable
# for every consumer build, hence the -dev Depends alongside shlibs.
Depends: ${shlibs:Depends}, ${misc:Depends},
 libwayland-dev, wayland-protocols, libdrm-dev, libxkbcommon-dev,
 libpixman-1-dev, libegl-dev, libgbm-dev, libgles-dev, libvulkan-dev,
 liblcms2-dev, libudev-dev, libseat-dev, libdisplay-info-dev,
 libliftoff-dev, libinput-dev, libxcb1-dev, libxcb-dri3-dev,
 libxcb-present-dev, libxcb-render0-dev, libxcb-render-util0-dev,
 libxcb-shm0-dev, libxcb-xfixes0-dev, libxcb-xinput-dev,
 libxcb-composite0-dev, libxcb-ewmh-dev, libxcb-icccm4-dev,
 libxcb-res0-dev, libxcb-errors-dev
Description: Modular Wayland compositor library (0.20 series)
 wlroots is a modular Wayland compositor library. This package tracks
 the 0.20 series required by current compositors.
