#!/usr/bin/make -f
# Debian build of upstream wlroots 0.20.x (meson). Single-tree source
# build; debhelper meson flow handles configure/build/install.
%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure --buildsystem=meson -- --prefix=/usr --libdir=lib/x86_64-linux-gnu -Dexamples=false

override_dh_auto_build:
	dh_auto_build --buildsystem=meson

override_dh_auto_test:
	:

override_dh_auto_install:
	dh_auto_install --buildsystem=meson
