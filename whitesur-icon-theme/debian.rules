#!/usr/bin/make -f
SHELL := /bin/bash
WS_SRC := $(shell dirname "$$(find . -maxdepth 2 -name install.sh -not -path './debian/*' | head -n1)")
SHIM := $(CURDIR)/debian/.icon-cache-shim
%:
	dh $@

override_dh_auto_configure:
	mkdir -p "$(SHIM)"
	printf '#!/bin/sh\nexit 0\n' > "$(SHIM)/gtk-update-icon-cache"
	chmod 755 "$(SHIM)/gtk-update-icon-cache"

override_dh_auto_build:
	:

override_dh_auto_test:
	:

override_dh_auto_install:
	mkdir -p debian/whitesur-icon-theme/usr/share/icons
	cd "$(WS_SRC)" && PATH="$(SHIM):$$PATH" bash ./install.sh --dest "$(CURDIR)/debian/whitesur-icon-theme/usr/share/icons" --theme all

override_dh_installchangelogs:
	dh_installchangelogs --no-trim

override_dh_clean:
	dh_clean
	rm -rf "$(SHIM)"
